views:
  - type: table
    name: 표
    filters:
      and:
        - categories.contains(link("상호작용 시스템(초기 기획)"))
    groupBy:
      property: tags
      direction: ASC
    order:
      - file.name
      - 작성 날짜
    sort:
      - property: 작성 날짜
        direction: DESC
    columnSize:
      file.name: 416
