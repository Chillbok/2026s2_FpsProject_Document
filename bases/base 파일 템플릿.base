views:
  - type: table
    name: 뷰
    filters:
      and:
        - note["노트 타입"].toString().containsAny("기본 문서", "데이터베이스")
    groupBy:
      property: 노트 타입
      direction: ASC
    order:
      - file.name
      - date
    sort:
      - property: date
        direction: DESC
    columnSize:
      file.name: 398
