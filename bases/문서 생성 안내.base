filters:
  and:
    - categories.contains(link("문서 생성 안내"))
views:
  - type: list
    name: 표
    groupBy:
      property: 노트 타입
      direction: ASC
    order:
      - file.name
      - 작성 날짜
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 287
    indentProperties: true
