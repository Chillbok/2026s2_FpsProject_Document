filters:
  and:
    - file.ext == "md"
views:
  - type: cards
    name: 뷰
    groupBy:
      property: tags
      direction: DESC
    groupOrder:
      - - "#데이터베이스"
      - - "#문서"
    order:
      - file.name
      - 작성 날짜
    sort:
      - property: 작성 날짜
        direction: DESC
    limit: 10
    indentProperties: true
