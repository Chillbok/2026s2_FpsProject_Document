views:
  - type: table
    name: 뷰
    filters:
      and:
        - file.tags.containsAny("문서", "데이터베이스")
    groupBy:
      property: file.tags
      direction: ASC
    order:
      - file.name
      - date
    sort:
      - property: date
        direction: DESC
    columnSize:
      file.name: 398
